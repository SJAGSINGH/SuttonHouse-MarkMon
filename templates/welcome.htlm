<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Sutton House</title>

  <style>
    body {
      margin: 0;
      background: #050607;
      color: #d4d7db;
      font-family: "Inter", sans-serif;
      display: flex;
      justify-content: center;
    }

    .container {
      width: 100%;
      max-width: 1100px;
      padding: 60px 20px;
    }

    /* =========================
       HERO
    ========================= */
    .hero {
      text-align: center;
      margin-bottom: 80px;
    }

    .hero h1 {
      font-size: 28px;
      font-weight: 500;
      letter-spacing: 0.5px;
      margin-bottom: 20px;
    }

    .hero p {
      font-size: 14px;
      color: #8b929a;
      max-width: 600px;
      margin: 0 auto 30px;
      line-height: 1.6;
    }

    .doctrine {
      font-size: 12px;
      color: #6f7680;
      margin-bottom: 40px;
      line-height: 1.8;
    }

    .enter-btn {
      padding: 10px 24px;
      border: 1px solid #1c2126;
      background: transparent;
      color: #cfd4da;
      cursor: pointer;
      font-size: 12px;
      letter-spacing: 1px;
      transition: all 0.2s ease;
    }

    .enter-btn:hover {
      border-color: #2c343b;
      color: #ffffff;
    }

    /* =========================
       BRIEFING
    ========================= */
    .briefing {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
      margin-bottom: 80px;
    }

    .panel {
      border: 1px solid #14181c;
      padding: 30px;
      background: rgba(255,255,255,0.01);
    }

    .panel h2 {
      font-size: 12px;
      letter-spacing: 1px;
      color: #8b929a;
      margin-bottom: 20px;
    }

    .panel p {
      font-size: 13px;
      line-height: 1.7;
      color: #c2c7cc;
      margin-bottom: 16px;
    }

    .panel .sub {
      margin-top: 20px;
      color: #7a828a;
      font-size: 12px;
    }

    /* =========================
       VIDEO PLACEHOLDER
    ========================= */
    .video-placeholder {
      height: 260px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px dashed #1c2126;
      color: #6f7680;
      font-size: 12px;
      text-align: center;
    }

    /* =========================
       FOOTER
    ========================= */
    .footer-line {
      text-align: center;
      font-size: 11px;
      color: #5f666f;
      letter-spacing: 1px;
    }

    /* =========================
       FADE TRANSITION
    ========================= */
    .fade-out {
      opacity: 0;
      transition: opacity 0.6s ease;
    }

    @media (max-width: 800px) {
      .briefing {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>
  <div class="container" id="page">

    <!-- HERO -->
    <section class="hero">
      <h1>Sutton House — A Market Operating System</h1>

      <p>
        Sutton House is a structured market monitoring system designed to govern behaviour,
        not generate activity.
      </p>

      <div class="doctrine">
        Signals are observed, not followed.<br/>
        Silence is a valid state.<br/>
        Access is limited.
      </div>

      <button class="enter-btn" onclick="enterSystem()">ENTER SYSTEM</button>
    </section>

    <!-- BRIEFING -->
    <section class="briefing">

      <!-- TEXT -->
      <div class="panel">
        <h2>SYSTEM BRIEFING</h2>

        <p>
          Sutton House is a structured market monitoring system built to reduce
          unnecessary decision-making.
        </p>

        <p>
          It defines macro conditions, tracks cycle progression, and interprets
          market behaviour to determine when participation is permitted.
        </p>

        <p>
          The system is designed to govern behaviour rather than encourage activity.
          It does not exist to produce constant signals. It exists to define conditions,
          enforce discipline, and preserve decision quality.
        </p>

        <p class="sub">
          Signals are observed, not followed.<br/>
          Silence is a valid state.
        </p>
      </div>

      <!-- VIDEO -->
      <div class="panel">
        <h2>SYSTEM BRIEFING VISUAL</h2>

        <div class="video-placeholder">
          System briefing visual will be available.<br/>
          Controlled access required.
        </div>
      </div>

    </section>

    <!-- FOOTER -->
    <div class="footer-line">
      Access is limited.
    </div>

  </div>

  <script>
    function enterSystem() {
      const page = document.getElementById("page");
      page.classList.add("fade-out");

      setTimeout(() => {
        window.location.href = "load.html";
      }, 600);
    }
  </script>

</body>
</html>
